# GHCR namespace, usually your GitHub username or org name
GHCR_OWNER=yshalsager

# Image tag published by GitHub Actions (e.g. latest, 20260413-abc1234)
IMAGE_TAG=latest

# Host port on your VPS
SYNC_PORT=8787

# Node adapter runtime settings
DB_SYNC_PORT=8787
DB_SYNC_BASE_URL=https://sync.example.com
DB_SYNC_DATA_DIR=/app/data
DB_SYNC_STORAGE_DRIVER=sqlite
DB_SYNC_ASSETS_DRIVER=filesystem
DB_SYNC_LOG_LEVEL=info

# Cognito values used for JWT validation.
#
# Defaults below point at Logseq's own Cognito, which is what the official
# clients and the stock GHCR web image authenticate against.
#
# To authenticate against the self-hosted emulator instead, replace all three
# with the values printed by images/cognito/scripts/seed-user.sh. Only one
# issuer can be accepted at a time -- there is no dual-issuer mode, so
# switching these means the official desktop and mobile apps can no longer
# sync against this server. See images/cognito/README.md.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_dtagLnju8
COGNITO_CLIENT_ID=69cs1lgme7p8kbgld8n5kseii6
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_dtagLnju8/.well-known/jwks.json

# Optional hardening for maintenance/admin endpoints
# DB_SYNC_ADMIN_TOKEN=replace-with-a-long-random-secret
