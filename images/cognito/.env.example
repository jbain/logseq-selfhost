# Host port for the Cognito emulator
COGNITO_PORT=9229

# Public origin of the emulator, as reached by browsers and the sync server.
# This is baked into every token as the issuer ("<domain>/<userPoolId>"), so
# changing it invalidates all existing tokens and requires updating
# COGNITO_ISSUER and COGNITO_JWKS_URL on the sync server.
COGNITO_ISSUER_DOMAIN=https://cognito.example.com
