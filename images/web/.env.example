# GHCR namespace, usually your GitHub username or org name
GHCR_OWNER=yshalsager

# Image tag published by GitHub Actions (e.g. latest, 20260419-abc1234)
IMAGE_TAG=latest

# Host port on your VPS
WEB_PORT=3001

# Self-hosted Cognito (optional). Only used by
# docker-compose.selfhost-auth.yml, which builds the image locally instead of
# pulling from GHCR. Populate from images/cognito/scripts/seed-user.sh output.
# SELFHOST_COGNITO_ENDPOINT=https://cognito.example.com
# SELFHOST_COGNITO_USER_POOL_ID=local_AbC12345
# SELFHOST_COGNITO_CLIENT_ID=replace-with-app-client-id
# SELFHOST_COGNITO_OAUTH_DOMAIN=cognito.example.com
